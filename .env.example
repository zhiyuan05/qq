# 通用 LLM 连接配置；旧版 DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL 仍兼容
CHATBOT_LLM_API_KEY=your-api-key-here
CHATBOT_LLM_BASE_URL=https://api.deepseek.com
# 公网部署必须设置，建议使用 32 位以上随机字符串
CHATBOT_WEB_AUTH_TOKEN=

# 留空时使用 persistence.db_path；多实例部署填写 PostgreSQL URL
CHATBOT_DATABASE_URL=
# 留空时使用 config.yaml；仅在 PostgreSQL 多副本部署时设为 true
CHATBOT_MULTI_INSTANCE=

# docker-compose.postgres.yml 使用；建议使用只含字母、数字的高强度值
CHATBOT_POSTGRES_PASSWORD=

# 平台密钥建议仅通过环境变量注入，不写入 config.yaml
CHATBOT_ONEBOT_ACCESS_TOKEN=
CHATBOT_TELEGRAM_TOKEN=

# 官方微信公众号；推荐上线后使用 safe 模式。不要在此接入个人微信 Hook。
CHATBOT_WECHAT_ENABLED=false
CHATBOT_WECHAT_TOKEN=
CHATBOT_WECHAT_APP_ID=
CHATBOT_WECHAT_APP_SECRET=
CHATBOT_WECHAT_ENCODING_AES_KEY=
CHATBOT_WECHAT_MESSAGE_MODE=plaintext
CHATBOT_WECHAT_EVENT_QUEUE_SIZE=512
CHATBOT_WECHAT_TIMEOUT=10

# Docker 非 root 运行用户；Linux 上通常与部署账号 UID/GID 保持一致
CHATBOT_UID=1000
CHATBOT_GID=1000

# 机器人 QQ 号；必须与扫码登录的账号一致，否则重启后无法快速登录
CHATBOT_QQ_ACCOUNT=

# 管理员 Agent 的服务器执行器令牌；由服务器侧生成，不要提交真实值
CHATBOT_ADMIN_EXECUTOR_TOKEN=

# 与服务器上已有项目共存时使用：不同项目名、容器前缀和空闲端口
# COMPOSE_PROJECT_NAME=qqbot
# CHATBOT_CONTAINER_PREFIX=qqbot-
# CHATBOT_WEB_PORT=18080
# CHATBOT_ONEBOT_PORT=13001
# NAPCAT_WEBUI_PORT=16099

# 语音为可选构建：./deploy.sh --voice 会同时设置下面两项
CHATBOT_INSTALL_VOICE=false
CHATBOT_VOICE_ENABLED=false
# 群配置持久化路径（容器内相对路径）
CHATBOT_GROUPS_PATH=data/groups.json
# 2C4G 服务器：默认 1536M；开启语音建议 2G
CHATBOT_MEMORY_LIMIT=1536M
